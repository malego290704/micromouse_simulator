{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Pocketbase",
            "type": "shell",
            "command": "./pocketbase serve --http=0.0.0.0:8090",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true
            }
        },
        {
            "label": "Update Pocketbase",
            "type": "shell",
            "command": "./pocketbase update"
        },
    ]
}